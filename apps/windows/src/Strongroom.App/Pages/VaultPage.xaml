<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Strongroom.App.Pages.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Strongroom.App">
    <Grid Margin="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left">
            <AppBarButton Icon="Add" Label="New item" Click="OnNew" />
            <AppBarButton Icon="Permissions" Label="Generator" Click="OnGenerator" />
            <AppBarButton Icon="Upload" Label="Export VTF" Click="OnExport" />
            <AppBarButton Icon="Download" Label="Import VTF" Click="OnImport" />
            <AppBarButton Icon="OpenFile" Label="Import passwords (CSV)">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="From Chrome or Edge" Tag="Chrome" Click="OnImportCsv" />
                        <MenuFlyoutItem Text="From Bitwarden" Tag="Bitwarden" Click="OnImportCsv" />
                        <MenuFlyoutItem Text="From 1Password" Tag="OnePassword" Click="OnImportCsv" />
                        <MenuFlyoutItem Text="From LastPass" Tag="LastPass" Click="OnImportCsv" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Delete" Label="Trash" Click="OnTrash" />
            <AppBarButton x:Name="TravelToggle" Icon="World" Label="Travel mode" Click="OnTravelToggle" />
            <AppBarButton x:Name="HelloToggle" Icon="Contact" Label="Windows Hello" Click="OnHelloToggle" />
            <AppBarButton Icon="Find" Label="Quick access (Ctrl+Shift+Space)" Click="OnQuickAccess" />
            <AppBarButton Icon="Placeholder" Label="Lock" Click="OnLock" />
        </CommandBar>
        <TextBox x:Name="Search" Grid.Row="1" PlaceholderText="Search titles, usernames, URLs, tags, folders" TextChanged="OnSearch" />
        <ListView x:Name="Items" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ItemRow">
                    <StackPanel Padding="0,6">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="Footer" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </Grid>
</Page>

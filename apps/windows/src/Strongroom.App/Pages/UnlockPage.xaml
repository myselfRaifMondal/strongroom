<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Strongroom.App.Pages.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="480" Margin="24" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Unlock Strongroom" Style="{StaticResource TitleTextBlockStyle}" />
        <PasswordBox x:Name="Password" Header="Master password" KeyDown="OnKeyDown" />
        <PasswordBox x:Name="SecretKey" Header="Secret Key" PlaceholderText="SR1-XXXXX-..." KeyDown="OnKeyDown" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="UnlockButton" Content="Unlock" Style="{StaticResource AccentButtonStyle}" Click="OnUnlock" />
            <Button x:Name="HelloButton" Content="Unlock with Windows Hello" Visibility="Collapsed" Click="OnHello" />
            <ProgressRing x:Name="Busy" IsActive="False" />
        </StackPanel>
        <TextBlock x:Name="HelloNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</Page>

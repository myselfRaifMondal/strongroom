<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Strongroom.App.Pages.ItemHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" Spacing="12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Back" Click="OnBack" />
                <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>
            <TextBlock Text="Earlier versions of this item, newest first. Restoring one keeps the current version in the history." TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyText" Text="No earlier versions." Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="RevisionsPanel" Spacing="8" />
            <TextBlock x:Name="Error" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
